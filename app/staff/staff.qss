/* STAFF APP
   Same palette as the customer app (app/ui/styles.qss) so the two windows
   look like one product, plus the semantic colours the operations screens
   need. Object names are defined in app/staff/theme.py and set from Python,
   because a mistyped selector here fails silently.
*/

QMainWindow, QWidget {
    background: #F1E8D8;
    color: #1A1A1A;
    font-family: "Inter 18pt";
}

/* TEXT NEVER CARRIES A PATCH
   The blanket cream above matches every plain QLabel (Caption, SectionLabel,
   HeroNumber...) and every QCheckBox text, and would draw a cream rectangle
   behind each line of text on a white card. Text paints nothing and shows
   its surface through instead -- identical on cream, white on cards, ink on
   dark cards. Boxes and inputs keep their own backgrounds; more specific
   rules below (statusPill, emptyState...) still win where one is intended. */
QLabel, QCheckBox {
    background: transparent;
}

/* REPORTS INTERIOR: WHITE EXCEPT THE TABLES
   The data box is a white pagePanel, but the plain hosts inside it -- the
   report-type list, its rows, the stacked pages, the panel roots, and the
   charts (which paint nothing themselves) -- all catch the blanket cream
   above and draw cream blocks inside the white box. Only the data tables
   keep a painted background, so these layers stay transparent and show the
   white box through. Scoped by object name: the dashboard's own ActiveRows
   and charts are untouched. */
QWidget#reportListHost,
QWidget#reportPanelHost,
QWidget#reportChart,
QWidget#reportStack,
QAbstractButton#reportRow {
    background: transparent;
}

QWidget#page {
    background: #F1E8D8;
}

/* THE PAGE SHEET
   The dashboard lays its title and its five cards on one white rounded sheet
   over the cream page. The radius is PAGE_PANEL_RADIUS, unified with the
   sidebar and the cards (28px) so all large sheets read as one family.
   The scroll area and its content have to be told to
   paint nothing: the blanket `QWidget { background: #F1E8D8 }` above matches
   them too and would otherwise draw a cream block inside the white sheet. */
QFrame#pagePanel {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 28px;
}

QScrollArea, #pageViewport, #pageContent {
    background: transparent;
}

/* The header is a plain `QWidget`, so the blanket cream above would paint a
   cream band across the top of the white sheet. Its two labels are already
   transparent from Python. Harmless on the unpanelled pages, whose page is
   cream anyway. */
QWidget#pageHeader {
    background: transparent;
}


/* SIDEBAR
   The floating navigation panel. Each row (icon, label, hover tint and the
   active leading bar) is painted by `NavItem`, so this dresses only the panel
   and its two labels -- a background or border on the row would fight the
   painted hover tint. The radius matches SIDEBAR_RADIUS in metrics.py.

   `#sidebarList` has to be told to paint nothing, for the same reason
   `#loginForm` below is: the blanket `QWidget { background: #F1E8D8 }` at the
   top of this file matches it and draws a cream panel straight over the white
   sidebar. The scrollbar is hidden outright rather than merely left unstyled,
   because a bar down the edge of a floating panel reads as an unfinished
   frame; the wheel still scrolls it. */

QFrame#sidebar {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 28px;
}

QFrame#sidebar QScrollBar:vertical {
    width: 0px;
    background: transparent;
    margin: 0;
}

QFrame#sidebar QScrollBar::handle:vertical {
    background: transparent;
}

QLabel#sidebarWordmark {
    background: transparent;
    color: #171717;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

QLabel#sidebarGroup {
    background: transparent;
    color: #6F6759;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

#sidebarList {
    background: transparent;
}

#sidebarItem {
    background: transparent;
    border: none;
}

QPushButton#ghostButton {
    background: #EEEAE1;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#ghostButton:hover {
    background: #E6E1D6;
    border-color: #C9BCA6;
}

QPushButton#ghostButton:disabled {
    color: #C4BBA9;
    border-color: #D8CCBB;
}

/* BOOKINGS TOOLS (concentric corners: 28px panel - 16px pad = 12px).
   Only the panel-facing outer corners round up; inner corners keep 6px.
   Single-row tools (Fleet, Customers) touch top AND bottom, so they use
   the combined values. */
QLineEdit#searchField[corner="topLeft"] {
    border-top-left-radius: 12px;
}

QLineEdit#searchField[corner="topLeftBottomLeft"] {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

QPushButton#ghostButton[corner="topRight"] {
    border-top-right-radius: 12px;
}

QPushButton#ghostButton[corner="topRightBottomRight"] {
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

QPushButton#ghostButton[corner="bottomLeft"] {
    border-bottom-left-radius: 12px;
}

/* DEMO BANNER
   Deliberately loud. The only realistic way to end up reconciling against
   fiction is to forget which database is open, so the window says so. */

QFrame#demoBanner {
    background: #B07D2B;
    border: none;
}

QLabel#demoBannerText {
    background: transparent;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
}

/* PAGE CHROME */

QLabel#pageTitle {
    background: transparent;
    font-size: 22px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    background: transparent;
    color: #8A8175;
    font-size: 13px;
}

/* TABLE STATES
   An empty table is ambiguous: it can mean "no rows" or "the query failed".
   The failure state gets its own colour and its own retry button. */

QWidget#tableHost {
    background: transparent;
    border: none;
}

/* BOOKINGS SKELETON (whole-page shimmer: tools + table mimics).
   Row hosts stay transparent so the blanket cream never squares in
   behind the shimmer bars; the mimic panels keep pagePanel white. */
QWidget#bookingsSkeletonRow {
    background: transparent;
    border: none;
}

/* FLEET DETAILS (gallery strip + 3D host)
   Transparent hosts so the blanket cream never bands behind the
   thumbnails or the viewer; the white card shows straight through. */
QWidget#fleetGalleryStrip, QWidget#fleetViewerHost {
    background: transparent;
    border: none;
}

QTableView {
    background: #FFFFFF;
    alternate-background-color: #FAF6EF;
    border: none;
    border-radius: 12px;
    gridline-color: #EDE6D9;
    selection-background-color: #EDE6D9;
    selection-color: #1A1A1A;
    font-size: 13px;
}

QHeaderView {
    background: transparent;
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QHeaderView::section {
    background: #EEEAE1;
    border: none;
    border-bottom: 1px solid #D8CCBB;
    padding: 9px 8px;
    font-size: 12px;
    font-weight: 700;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
}

QTableView QTableCornerButton::section {
    background: #EEEAE1;
    border: none;
    border-top-left-radius: 12px;
}

QLabel#emptyState {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 12px;
    color: #8A8175;
    font-size: 14px;
}

QLabel#errorState {
    background: #FFFFFF;
    border: 1px solid #A8452F;
    border-radius: 12px;
    color: #A8452F;
    font-size: 14px;
    font-weight: 600;
    padding: 12px 20px;
}

QLabel#errorDetail {
    background: transparent;
    color: #8A8175;
    font-size: 12px;
}

QPushButton#retryButton {
    background: #A8452F;
    border: 1px solid #A8452F;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 7px 18px;
}

QPushButton#retryButton:hover {
    background: #903926;
    border-color: #903926;
}

/* STATUS PILL
   Background is set from Python via colour_for() in theme.py, because the
   colour depends on the value and a stylesheet cannot select on cell text. */

QLabel#statusPill {
    border-radius: 6px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 700;
}

/* INPUTS */

QLineEdit, QDateEdit, QDateTimeEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QTextEdit {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    selection-background-color: #D8CCBB;
    selection-color: #1A1A1A;
}

QLineEdit:focus, QDateEdit:focus, QDateTimeEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus {
    border: 1px solid #171717;
}

/* Compact date edits (Bookings From/To): less vertical padding so the
   yyyy section has room inside a fixed-height row. */
QDateEdit[compact="true"] {
    padding: 4px 10px;
}

QLineEdit:disabled, QDateEdit:disabled, QDateTimeEdit:disabled,
QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QTextEdit:disabled {
    background: #F4EFE5;
    color: #C4BBA9;
}

/* An inline validation error, shown under the field that caused it. */
QLabel#fieldError {
    background: transparent;
    color: #A8452F;
    font-size: 12px;
    font-weight: 600;
}

QLabel#fieldLabel {
    background: transparent;
    color: #8A8175;
    font-size: 12px;
    font-weight: 600;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    selection-background-color: #EDE6D9;
    selection-color: #1A1A1A;
    outline: none;
}

/* BUTTONS */

QPushButton#primaryButton {
    background: #1A1A1A;
    border: 1px solid #1A1A1A;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
}

QPushButton#primaryButton:hover {
    background: #171717;
    border-color: #171717;
}

QPushButton#primaryButton:disabled {
    background: #C4BBA9;
    border-color: #C4BBA9;
    color: #FFFFFF;
}

QPushButton#secondaryButton {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 18px;
}

QPushButton#secondaryButton:hover {
    background: #F4EFE5;
    border-color: #C9BCA6;
}

QPushButton#dangerButton {
    background: #FFFFFF;
    border: 1px solid #A8452F;
    border-radius: 6px;
    color: #A8452F;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
}

QPushButton#dangerButton:hover {
    background: #A8452F;
    color: #FFFFFF;
}

/* LOGIN

   Flat: no panel, no shadow, no card. The window behind this is already one
   surface, and a card on it read as a different object dropped in the middle.
   The wordmark is the only large type on the screen. */

QWidget#loginRoot {
    background: #FFFFFF;
}

/* The form column. It has to be told to paint nothing, because the blanket
   `QWidget { background: #F1E8D8 }` at the top of this file matches it -- it
   has no object name of its own to override it with -- and it then draws a
   cream panel straight over the white page. */
QWidget#loginForm {
    background: transparent;
}

QLabel#loginWordmark {
    background: transparent;
    color: #171717;
    font-size: 32px;
    font-weight: 700;
}

QLabel#loginCaption {
    background: transparent;
    color: #9B978F;
    font-size: 16px;
    font-weight: 400;
}

/* A field is a rule, not a box. The label floats above the rule when the field
   is in use, so the rule carries the whole affordance and gets heavier on
   focus. Padding is asymmetric on purpose: the lifted label needs the room. */
QLineEdit#loginField {
    background: transparent;
    border: none;
    border-bottom: 1px solid #CFC6B5;
    border-top: 20px solid transparent;
    color: #171717;
    font-size: 15px;
    padding: 6px 1px;
    /* Selected text is ink on sand. The sand is far too light to carry white
       text -- that pairing measures 1.42:1 -- so the ink flips instead. */
    selection-background-color: #E5D7BE;
    selection-color: #171717;
}

QLineEdit#loginField:focus {
    border-bottom: 2px solid #E5D7BE;
    padding-bottom: 5px;
}

/* The eye inside the field. It paints its own icon and nothing else, so it is
   told outright not to take a background. Today the custom paintEvent never
   calls up to QStyle, so nothing would fill it anyway -- but the global
   QWidget rule fills this page with cream, and the moment anyone adds
   `super().paintEvent()` for a hover background this becomes a cream square
   behind the icon. The same trap took the form column out earlier. */
QAbstractButton#loginReveal {
    background: transparent;
    border: none;
}

/* Down, this is the placeholder sitting in the field. */
QLabel#loginLabel {
    background: transparent;
    color: #9B978F;
    font-size: 16px;
    font-weight: 400;
}

/* Up, it has become a label, so it is smaller and takes the accent.

   A darker shade of the button's sand rather than the sand itself: at 12px
   this has to clear 4.5:1, and #E5D7BE on white is 1.42:1 -- invisible. This
   is 4.84:1 and still reads as the same colour. */
QLabel#loginLabelLifted {
    background: transparent;
    color: #8A6D3F;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#loginButton {
    background: #E5D7BE;
    border: 1px solid #E5D7BE;
    border-radius: 6px;
    color: #171717;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 18px;
}

QPushButton#loginButton:hover {
    background: #DCCBAE;
    border-color: #DCCBAE;
}

QPushButton#loginButton:pressed {
    background: #CDB994;
    border-color: #CDB994;
}

QPushButton#loginButton:disabled {
    background: #E6DFD2;
    border-color: #E6DFD2;
    color: #A9A296;
}

QLabel#loginError {
    background: #FDF0ED;
    border: 1px solid #C0563A;
    border-left: 3px solid #A8452F;
    border-radius: 4px;
    color: #8E3A28;
    font-size: 13px;
    font-weight: 500;
    padding: 9px 11px;
}

QLabel#loginFoot {
    background: transparent;
    color: #9B978F;
    font-size: 12px;
}

/* TOAST
   Non-blocking confirmation. Anchored bottom-right by app/staff/feedback.py. */

QFrame#toast {
    background: #1A1A1A;
    border: none;
    border-radius: 6px;
}

QLabel#toastText {
    background: transparent;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
}

QLabel#toastText[kind="ok"] {
    color: #B9D4C1;
}

QLabel#toastText[kind="error"] {
    color: #F0BFB2;
}

/* DIALOGS */

QDialog {
    background: #F1E8D8;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #D8CCBB;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #C9BCA6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #D8CCBB;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* DASHBOARD
   The card system. Radius and padding are the numbers in app/staff/metrics.py;
   tests/test_staff_dashboard.py asserts this file agrees with them, because a
   QSS value cannot be read back at runtime and a mismatch is invisible until
   two cards sit next to each other.

   Two variants off one selector, selected by the `dark` property rather than
   an object name: a dark card is still a card, and the widgets are built the
   same way either way.
*/

QFrame[class="card"] {
    border-radius: 28px;
    border: 1px solid #D8CCBB;
    background: #FFFFFF;
}

/* Check-details card: the same card recipe at an 8px radius (ID wins over
   the class rule above; the painted shadow follows Card's own radius). */
QFrame#vehicleDetailsCard {
    border-radius: 18px;
    border: 1px solid #D8CCBB;
    background: transparent;
}

/* Check-details hosts: the blanket QWidget cream would otherwise paint a
   sharp square behind the rounded card (visible in the 8px corner cutouts).
   Same pattern as #pageViewport / #vehicleRailViewport. */
QScrollArea#vehicleDetailsScroll, #vehicleDetailsViewport, #vehicleDetailsPanel {
    background: transparent;
    border: none;
}

/* Frosted-glass picture behind the check-details card. The blur + dim live
   in the pixmap itself; the rule only keeps the blanket cream off it. */
QLabel#vehicleDetailsBackdrop {
    background: transparent;
    border: none;
}

/* RENTAL WIZARD (Steps 2-5, same overlay card)
   Step hosts stay transparent like the details panel, so the blanket cream
   never squares in behind the rounded card. Option boxes copy the filter
   cards: white 8px boxes, ink border when picked. Square chips, no stadiums,
   no circles. */
QWidget#wizardStep {
    background: transparent;
    border: none;
}

QFrame#wizardBox {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
}

QLabel#wizardChip {
    border-radius: 2px;
}

QPushButton#wizardChoice {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 12px;
    text-align: left;
}

QPushButton#wizardChoice:hover {
    background: #FFFFFF;
    border-color: #B8A68A;
}

QPushButton#wizardChoice:checked {
    border: 1px solid #171717;
}

QFrame[class="card"][dark="true"] {
    border-radius: 28px;
    /* No border on the dark cards. A one-pixel outline the same family as the
       ink reads as a hairline of lighter grey around the edge, which is the
       thing that makes a flat dark panel look like a UI element rather than a
       hole; the brief's own flat cards have none. */
    border: none;
    background: #171717;
}

QFrame[class="card"][hover="true"] {
    background: #302F2D;
}

/* The revenue card's day picker. A combo so every day is reachable, dressed as
   a pill so it still reads as one control rather than a form field dropped into
   the card. The radius and min-height set the pill, and the drop-down keeps the
   platform arrow so it is obvious it opens. */
QComboBox#revenuePeriod {
    background: #EEEAE1;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 2px 6px 2px 12px;
    min-height: 24px;
    font-size: 12px;
    font-weight: 600;
    color: #171717;
}

QComboBox#revenuePeriod:hover {
    background: #E6E1D6;
}

QComboBox#revenuePeriod::drop-down {
    border: none;
    width: 22px;
}

QComboBox#revenuePeriod QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #EDE6D9;
    selection-color: #171717;
    outline: none;
}


QLabel#rowName {
    background: transparent;
}

QLabel#sectionLabel {
    background: transparent;
    letter-spacing: 0.2px;
}

/* VEHICLE CARDS (New Rental)
   A vehicle card paints its own panel and shadow so the hover lift can move
   them, so the frame and its shell stay unpainted. The blanket `QWidget` cream
   at the top of this file would otherwise fill them. The button's radius is
   VEHICLE_BTN_RADIUS; the test asserts the two agree. */
QFrame#vehicleCard, #vehicleSlot, #vehicleCardSurface, #vehicleCardSkeleton,
#brandRails, #brandSection, #vehicleRail, #vehicleRailViewport,
#vehicleRailHost {
    background: transparent;
    border: none;
}

QPushButton#vehicleDetailsButton {
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
    border-radius: 8px;
    color: #1A1A1A;
    font-size: 12px;
    font-weight: 700;
    padding: 0 14px;
}

QPushButton#vehicleDetailsButton:hover {
    background: #EEEAE1;
    border-color: #EEEAE1;
}

/* FLEET STATUS BADGE (New Rental)
   Fleet truth on the photo corner: white 8px box, square chip, no stadium.
   Colours come from STATUS_COLOURS in theme.py, set inline per vehicle. */
QFrame#vehicleStatusBadge {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
}

QLabel#vehicleStatusChip {
    border-radius: 2px;
}

QLabel#vehicleStatusText {
    background: transparent;
    color: #1A1A1A;
}

/* FROSTED OVERLAY (generic host, e.g. Bookings action panels)
   Same discipline as the check-details overlay: only the overlay itself
   may carry the dim; every host layer stays transparent. */
QLabel#frostedBackdrop {
    background: transparent;
    border: none;
}

QScrollArea#frostedScroll, #frostedViewport {
    background: transparent;
    border: none;
}

/* BRAND ROWS (New Rental)
   The fleet is grouped by make: a heading over a side-scrolling rail. The rail
   hides its vertical bar and shows a thin horizontal one, so a long brand is
   scrolled sideways rather than wrapped. */
QLabel#brandHeading {
    color: #1A1A1A;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
}

QScrollArea#vehicleRail QScrollBar:horizontal {
    height: 6px;
    background: transparent;
    margin: 0;
}

QScrollArea#vehicleRail QScrollBar::handle:horizontal {
    background: #D8CCBB;
    border-radius: 3px;
    min-width: 40px;
}

QScrollArea#vehicleRail QScrollBar::handle:horizontal:hover {
    background: #B8A68A;
}

QScrollArea#vehicleRail QScrollBar::add-line:horizontal,
QScrollArea#vehicleRail QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}

QScrollArea#vehicleRail QScrollBar::add-page:horizontal,
QScrollArea#vehicleRail QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* THE FILTER POPOVER (New Rental)
   filter-layout.md: `.filter-dropdown` with a narrow `.filter-side` (surface)
   and a wider `.filter-content` (paper, one continuous scroll, rules between
   sections). White box, 8px radius, 1px border. Selected boxes get a dark
   border + filled tick; backgrounds never change. */
/* The dropdown's outer box IS the app background: transparent here, so the
   page shows straight through. The two floating cards paint their own
   rounded frames (see _PanelCard). Square window corners are cut by
   WA_TranslucentBackground on the popover. */
QFrame#filterPopover {
    background: transparent;
    border: none;
}

/* Floating panels: transparent in the sheet so the painted card frames show.
   Without these the blanket QWidget cream would square-fill behind them. */
QFrame#filterSideCard, QFrame#filterContentCard {
    background: transparent;
    border: none;
}

QFrame#filterPopoverDivider {
    background: #D8CCBB;
    border: none;
}

/* Scroll regions sit inside the painted cards, so they stay transparent and
   let the card white show through. */
QScrollArea#filterCategoryScroll, QWidget#filterCategoryHost,
QScrollArea#filterPaneScroll, QWidget#filterContent {
    background: transparent;
    border: none;
}

/* Selectable option boxes: `.filter-card` (picture) and text-only variant.
   Selected == dark border + filled tick; background stays white. */
QAbstractButton#filterCard {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    text-align: left;
}

QAbstractButton#filterCard:hover {
    background: #FFFFFF;
    border-color: #B8A68A;
}

QAbstractButton#filterCard[selected="true"] {
    border: 1px solid #171717;
}

QAbstractButton#filterCard:disabled {
    color: #B5ADA1;
    border-color: #E4DCD0;
}

QLabel#filterCardLabel {
    background: transparent;
    border: none;
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 500;
}

QLabel#filterCardLabel[muted="true"] {
    color: #B5ADA1;
}

QLabel#filterCardImg {
    background: #EEEAE1;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
}

QLabel#filterCardTick {
    background: #171717;
    border: none;
    border-radius: 9px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
}

/* Passenger stepper: `[ - ] value [ + ]`. */
QPushButton#filterStepperBtn {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    color: #1A1A1A;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#filterStepperBtn:hover:enabled {
    background: #E6E1D6;
    border-color: #B8A68A;
}

QPushButton#filterStepperBtn:disabled {
    color: #B5ADA1;
    border-color: #E4DCD0;
}

QLabel#filterStepperValue {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 700;
}

/* Pinned footer actions: Clear (quiet) + Apply (primary ink). */
QPushButton#filterApply {
    background: #171717;
    border: 1px solid #171717;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    padding: 0 16px;
}

QPushButton#filterApply:hover {
    background: #302F2D;
    border-color: #302F2D;
}

/* The Filters button in the pinned bar. A quiet pill, not a primary action: it is
   a way in to the filters, and the count beside it is the thing being read. */
QPushButton#filterButton {
    background: #EEEAE1;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #1A1A1A;
    padding: 0 14px;
}
QPushButton#filterButton:hover {
    background: #F3EEE4;
    border-color: #B8A68A;
}

QWidget#pagePinned QLineEdit#searchField {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    padding-left: 16px;
    padding-right: 16px;
}

QWidget#pagePinned QPushButton#filterButton {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

QWidget#pagePinned QPushButton#filterClear {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 0px;
}

/* The group headings use the same small-caps treatment as the dashboard's column
   labels, so the popover reads as part of the staff app rather than a foreign
   widget. */
QLabel#filterGroupHeading {
    color: #8A8175;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    background: transparent;
}

QWidget#filterPane, QWidget#filterPaneHost,
QWidget#filterGroup, QWidget#filterPanes, QWidget#pagePinned,
QWidget#filterContent, QLabel#filterCardLabel,
QLabel#filterCardTick {
    background: transparent;
    border: none;
}

QLabel#filterCardImg {
    background: #EEEAE1;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
}

QLabel#filterCount {
    color: #8A8175;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QPushButton#filterClear {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #1A1A1A;
    padding: 0 12px;
}
QPushButton#filterClear:hover:enabled {
    background: #F3EEE4;
    border-color: #B8A68A;
}
QPushButton#filterClear:disabled {
    color: #B5ADA1;
    border-color: #E4DCD0;
}

/* A disabled group is dimmed rather than hidden: the CC buckets stay visible and
   ticked when Motorcycle is unticked, so the clerk can see why they no longer
   apply and get them back by re-ticking. */
QCheckBox#filterCheck:disabled, QLabel#filterGroupHeading:disabled {
    color: #B5ADA1;
}

/* FLEET SIDE (New Rental)
   The search, the Filters button, the count and Clear all sit in the pinned row
   above the scroll area, so they stay reachable from any scroll position -- they
   used to scroll away with the first flick. The empty note is the one thing that
   still belongs inside the scroll area. */
QWidget#brandRails, QLabel#nrEmpty {
    background: transparent;
    border: none;
}

QLabel#nrCount {
    color: #8A8175;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#nrEmpty {
    color: #8A8175;
    font-size: 15px;
    background: transparent;
}

/* CALENDAR POPUP (QDateEdit dropdowns: Bookings From/To, wizard, details)
   The generic input rule (7px padding, 13px) leaks into the calendar's own
   nav-bar widgets: the year QSpinBox wants ~29px inside a ~20-25px bar, so
   typed years clip top/bottom and the month arrow sits low. Compact
   overrides scoped to the popup only; form fields keep their metrics. */
QCalendarWidget QSpinBox, QCalendarWidget QLineEdit {
    padding: 0px 2px;
    font-size: 12px;
    border: 1px solid #D8CCBB;
    border-radius: 4px;
    background: #FFFFFF;
}

QCalendarWidget QToolButton {
    padding: 2px 6px;
    border: none;
    background: transparent;
    font-size: 12px;
}

QCalendarWidget QToolButton::menu-indicator {
    width: 0;
}

QCalendarWidget QAbstractSpinBox::up-button,
QCalendarWidget QAbstractSpinBox::down-button {
    width: 14px;
}

QCalendarWidget QAbstractItemView {
    selection-background-color: #EDE6D9;
    selection-color: #1A1A1A;
}


/* ===================================================================
   COUNTER RENTAL MODAL (Vehicle details + Scheduling/Customer/Payment/Done)
   Scoped to #vehicleDetailsCard so the rest of the staff app keeps its
   existing 8px controls. The reference is a warm paper card: 18px radius,
   white sheet, ink primary, cream recap.
   =================================================================== */

QFrame#vehicleDetailsCard {
    background: transparent;
}

QFrame#vehicleDetailsCard QPushButton#primaryButton,
QFrame#vehicleDetailsCard QPushButton#secondaryButton {
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
}

QFrame#vehicleDetailsCard QPushButton#primaryButton {
    background: #171717;
    border: 1px solid #171717;
    color: #FFFFFF;
    font-weight: 600;
}

QFrame#vehicleDetailsCard QPushButton#primaryButton:hover {
    background: #2A2A2A;
    border-color: #2A2A2A;
}

QFrame#vehicleDetailsCard QPushButton#primaryButton:disabled {
    background: #D7CCBA;
    border-color: #D7CCBA;
    color: #FFFFFF;
}

QFrame#vehicleDetailsCard QPushButton#secondaryButton {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    color: #171717;
}

QFrame#vehicleDetailsCard QPushButton#secondaryButton:hover {
    background: #F7F1E7;
    border-color: #C6B8A3;
}

QFrame#vehicleDetailsCard QPushButton#secondaryButton:disabled {
    background: #F4EFE5;
    border-color: #E4DACA;
    color: #B8AD9C;
}

QPushButton#modalCancel {
    background: transparent;
    border: none;
    color: #9B2C1F;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 2px;
    text-align: left;
}

QPushButton#modalCancel:hover {
    color: #7F2117;
    text-decoration: underline;
}

QPushButton#linkButton {
    background: transparent;
    border: none;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 0;
    text-align: left;
}

QPushButton#linkButton:hover {
    color: #6B5E4F;
    text-decoration: underline;
}

QFrame#modalFooter {
    background: transparent;
    border: none;
    border-top: 1px solid #E8DFD1;
}

QLabel#modalTitle {
    background: transparent;
    color: #171717;
}

QLabel#modalSubtitle {
    background: transparent;
    color: #6B5E4F;
}

QLabel#modalHint {
    background: transparent;
    color: #6B5E4F;
}

QFrame#modalRule,
QFrame#recapRule {
    background: #E7DDCE;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QWidget#rentalModalBody,
QWidget#modalGallery,
QWidget#galleryStage {
    background: transparent;
    border: none;
}

/* -- progress rail -------------------------------------------------- */

QFrame#stepChip {
    background: #EEEAE1;
    border: 1px solid transparent;
    border-radius: 15px;
}

QFrame#stepChip[state="current"] {
    background: #171717;
    border-color: #171717;
}

QFrame#stepChip[state="done"] {
    background: #E4F1E4;
    border-color: #E4F1E4;
}

QLabel#stepDot {
    border-radius: 10px;
    font-size: 10px;
    font-weight: 700;
    background: #E1D8C9;
    color: #6B5E4F;
}

QLabel#stepDot[state="current"] {
    background: transparent;
    color: #FFFFFF;
}

QLabel#stepDot[state="done"] {
    background: #4F7A5B;
    color: #FFFFFF;
}

QLabel#stepName {
    background: transparent;
}

/* -- recap column --------------------------------------------------- */

QFrame#modalRecap {
    background: #EFE6D5;
    border: 1px solid #E7DBC7;
    border-radius: 14px;
}

QLabel#recapTitle {
    background: transparent;
    color: #171717;
}

QLabel#recapValue {
    background: transparent;
    color: #171717;
}

/* -- vehicle row ----------------------------------------------------- */

QFrame#modalVehicleRow {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 10px;
}

QLabel#modalVehicleThumb {
    background: #EEEAE1;
    border-radius: 7px;
}

QLabel#modalVehicleName {
    background: transparent;
    color: #171717;
}

QLabel#modalVehicleMeta {
    background: transparent;
    color: #6B5E4F;
}

/* -- status chips ---------------------------------------------------- */

QLabel#statusChip {
    border-radius: 10px;
    font-size: 10px;
    font-weight: 600;
    padding: 3px 9px;
    background: #EEEAE1;
    color: #6B5E4F;
}

QLabel#statusChip[tone="ok"] {
    background: #DCEEDC;
    color: #3F6D4E;
}

QLabel#statusChip[tone="warn"] {
    background: #F6E6C8;
    color: #8A6523;
}

QLabel#statusChip[tone="danger"] {
    background: #F6E0DB;
    color: #9B2C1F;
}

QLabel#statusChip[tone="neutral"] {
    background: #EEEAE1;
    color: #6B5E4F;
}

QLabel#plateChip {
    background: #EEEAE1;
    border-radius: 6px;
    color: #6B5E4F;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
}

/* -- spec / meta tiles ---------------------------------------------- */

QFrame#modalSpecTile,
QFrame#modalMetaTile {
    background: #EEEAE1;
    border: none;
    border-radius: 8px;
}

QLabel#specLabel,
QLabel#metaLabel {
    background: transparent;
    color: #6B5E4F;
}

QLabel#specValue,
QLabel#metaValue {
    background: transparent;
    color: #171717;
}

/* -- availability list ---------------------------------------------- */

QFrame#availabilityRow {
    background: transparent;
    border: none;
}

QFrame#availabilityRow[divider="true"] {
    border-top: 1px solid #ECE3D5;
}

QLabel#availabilityDate {
    background: transparent;
    color: #171717;
}

QLabel#availabilityMeta {
    background: transparent;
    color: #6B5E4F;
}

/* -- day strip ------------------------------------------------------- */

QLabel#dayStripMonth {
    background: transparent;
    color: #6B5E4F;
}

QFrame#dayTile {
    background: #EEEAE1;
    border: none;
    border-radius: 8px;
}

QFrame#dayTile[state="selected"] {
    background: #171717;
}

QFrame#dayTile[state="confirmed"] {
    background: #D7E9DA;
}

QFrame#dayTile[state="pending"] {
    background: #F6E5C6;
}

QFrame#dayTile[state="free"] {
    background: #EEEAE1;
}

QLabel#dayWeekday {
    background: transparent;
    font-size: 8px;
}

QLabel#dayNumber {
    background: transparent;
    font-size: 12px;
}

QLabel#legendChip {
    border-radius: 2px;
}

QFrame#wizardLegend {
    background: #F1E8D8;
    border: none;
    border-radius: 8px;
}

/* -- notices / result bars ------------------------------------------- */

QFrame#modalNotice {
    background: #F7E9CE;
    border: 1px solid #EEDDBB;
    border-radius: 8px;
}

QFrame#modalNotice[tone="danger"] {
    background: #F6E0DB;
    border-color: #EBC9C0;
}

QLabel#modalNoticeText {
    background: transparent;
    color: #171717;
}

QLabel#modalNoticeIcon {
    background: transparent;
}

QFrame#resultBar {
    background: #E4F1E4;
    border: 1px solid #CFE3D1;
    border-radius: 8px;
}

QFrame#resultBar[tone="danger"] {
    background: #F6E0DB;
    border-color: #EBC9C0;
}

QFrame#resultBar[tone="warn"] {
    background: #F7E9CE;
    border-color: #EEDDBB;
}

QLabel#resultText {
    background: transparent;
    color: #171717;
}

/* -- customer -------------------------------------------------------- */

QFrame#customerCard {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 12px;
}

QLabel#customerAvatar {
    background: #EFE6D5;
    border-radius: 18px;
    color: #171717;
    font-size: 12px;
    font-weight: 700;
}

QLabel#customerName {
    background: transparent;
    color: #171717;
    font-size: 15px;
    font-weight: 700;
}

QLabel#customerLicence {
    background: transparent;
    color: #6B5E4F;
}

/* -- payment --------------------------------------------------------- */

QFrame#paymentOption {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 10px;
}

QFrame#paymentOption[selected="true"] {
    border: 1px solid #171717;
}

QRadioButton#paymentRadio {
    background: transparent;
    spacing: 0;
}

QRadioButton#paymentRadio::indicator {
    width: 17px;
    height: 17px;
    border-radius: 9px;
    border: 1px solid #B6A791;
    background: #FFFFFF;
}

QRadioButton#paymentRadio::indicator:checked {
    background: #171717;
    border: 5px solid #FFFFFF;
}

QLabel#paymentTitle {
    background: transparent;
    color: #171717;
    font-size: 13px;
    font-weight: 700;
}

QLabel#paymentSub {
    background: transparent;
    color: #6B5E4F;
    font-size: 11px;
}

QToolButton#methodChoice {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 10px;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 6px;
}

QToolButton#methodChoice:hover {
    border-color: #B8A68A;
    background: #FFFDF9;
}

QToolButton#methodChoice:checked {
    border: 1px solid #171717;
    background: #FFFFFF;
}

/* -- done ------------------------------------------------------------ */

QFrame#balanceBox {
    background: #F7E9CE;
    border: none;
    border-radius: 10px;
}

QFrame#summaryCard {
    background: #FFFFFF;
    border: 1px solid #E3D8C8;
    border-radius: 10px;
}

QFrame#doneCheck {
    background: #DCEEDC;
    border: none;
    border-radius: 12px;
}

QLabel#doneCheckGlyph {
    background: transparent;
    color: #4F7A5B;
    font-size: 20px;
    font-weight: 700;
}

QFrame#receiptRow {
    background: #FFFFFF;
    border: 1px solid #E3D8C8;
    border-radius: 10px;
}

QLabel#receiptIcon {
    background: #EEEAE1;
    border-radius: 7px;
    color: #6B5E4F;
}

QLabel#receiptName {
    background: transparent;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
}

QLabel#receiptNote {
    background: transparent;
    color: #6B5E4F;
    font-size: 11px;
}

/* -- gallery --------------------------------------------------------- */

QFrame#galleryHero {
    background: #EFE6D5;
    border: none;
    border-radius: 12px;
}

QFrame#galleryHero QLabel#galleryImage {
    background: transparent;
}

QLabel#galleryHint {
    background: transparent;
    color: #6B5E4F;
    font-size: 10px;
}

QToolButton#galleryTab {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 10px;
    color: #171717;
    font-size: 10px;
    font-weight: 600;
    padding: 5px 3px;
}

QToolButton#galleryTab:hover {
    background: #FFFDF9;
    border-color: #B8A68A;
}

QToolButton#galleryTab:checked {
    border: 1px solid #171717;
    background: #FFFFFF;
}

QPushButton#viewerControl {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 7px;
    color: #171717;
    font-size: 10px;
    font-weight: 600;
    padding: 5px 10px;
}

QPushButton#viewerControl:hover {
    background: #F7F1E7;
}

QPushButton#viewerControl:checked {
    background: #171717;
    border-color: #171717;
    color: #FFFFFF;
}

QPushButton#viewerControlLight {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 7px;
    color: #171717;
    font-size: 10px;
    font-weight: 600;
    padding: 5px 10px;
}

QLabel#galleryBadge {
    background: #FFFFFF;
    border: 1px solid #E7DBC7;
    border-radius: 8px;
    color: #171717;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 9px;
}

/* -- detail right column -------------------------------------------- */

QScrollArea#modalColumnScroll,
QScrollArea#modalColumnScroll QWidget#modalColumnViewport {
    background: transparent;
    border: none;
}

QLabel#detailPriceSuffix {
    background: transparent;
    color: #6B5E4F;
}

QPushButton#checkAvailability {
    min-height: 36px;
}

/* ======================================================================
   WARM LIST PAGES AND BOOKING MODALS
   Opt-in: only widgets with variant="warm" or the warm object names below
   are affected, so Dashboard, Reports, Settings, and sign-in keep the
   existing sheet look. Values are sampled from the seven booking
   references (1440x970, 1360px content column).
   ====================================================================== */

QFrame#pagePanel[variant="warm"] {
    background: #FFFFFF;
    border: 1px solid #DFD4C5;
    border-radius: 18px;
}

QFrame#pagePanel[variant="warmHost"] {
    background: transparent;
    border: none;
}

/* The data card's own title, used by the Inspections audit. */
QLabel#warmCardTitle {
    background: transparent;
    color: #171717;
    font-size: 15px;
    font-weight: 700;
}

/* -- filter chips ---------------------------------------------------- */

QPushButton#statusFilterChip {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 15px;
    color: #171717;
    font-size: 13px;
    font-weight: 500;
    padding: 0 14px;
}

QPushButton#statusFilterChip:hover {
    background: #F6EEDC;
}

QPushButton#statusFilterChip:checked {
    background: #171717;
    border-color: #171717;
    color: #FFFFFF;
}

/* -- cream selection bar --------------------------------------------- */

QFrame#selectionBar {
    background: #EADBBB;
    border: none;
    border-radius: 14px;
}

QLabel#selectionSummary {
    background: transparent;
    color: #4D4A42;
    font-size: 15px;
    font-weight: 400;
}

QPushButton#barPrimary {
    background: #171717;
    border: 1px solid #171717;
    border-radius: 18px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#barPrimary:hover {
    background: #333333;
}

QPushButton#barAction {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 18px;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#barAction:hover {
    background: #F6EEDC;
}

QPushButton#barDanger {
    background: #FFFFFF;
    border: 1px solid #C07B72;
    border-radius: 18px;
    color: #9B2C1F;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#barDanger:hover {
    background: #F8E0DC;
}

QPushButton#barPrimary:disabled,
QPushButton#barAction:disabled,
QPushButton#barDanger:disabled {
    background: #EADBBB;
    border-color: #DCCBAA;
    color: #A79B87;
}

/* -- warm table ------------------------------------------------------ */

QTableView[variant="warm"] {
    background: #FFFFFF;
    alternate-background-color: #FFFFFF;
    border: none;
    border-radius: 12px;
    gridline-color: #F0EBE2;
    selection-background-color: #F6EEDC;
    selection-color: #171717;
    font-size: 13px;
}

QTableView[variant="warm"]::item {
    border-bottom: 1px solid #F0EBE2;
    padding: 0 8px;
}

QTableView[variant="warm"]::item:selected {
    background: #F6EEDC;
    color: #171717;
}

QHeaderView#warmHeader {
    background: transparent;
    border: none;
}

QHeaderView#warmHeader::section {
    background: #EEEAE1;
    border: none;
    color: #6F685E;
    font-size: 12px;
    font-weight: 600;
    padding: 0 8px;
}

QHeaderView#warmHeader::section:first {
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

QHeaderView#warmHeader::section:last {
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* -- table chips ----------------------------------------------------- */

QLabel#tableChip {
    border: none;
    /* Half of TableChip.HEIGHT: Qt ignores a radius larger than half the
       label height, so this must stay in sync with the 22px fixed height. */
    border-radius: 11px;
    font-size: 12px;
    font-weight: 500;
    padding: 2px 10px;
}

QLabel#tableChip[tone="ok"] {
    background: #DDF0E0;
    color: #2C6A3C;
}

QLabel#tableChip[tone="warn"] {
    background: #F7E4C4;
    color: #744A15;
}

QLabel#tableChip[tone="danger"] {
    background: #F6DDD8;
    color: #9B2C1F;
}

QLabel#tableChip[tone="neutral"] {
    background: #E6E1D6;
    color: #5F574C;
}

/* Ledger kinds are categories, not states: outlined instead of filled. */
QLabel#tableChip[tone="outline"] {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    color: #171717;
}

/* The chip's layout host must not catch the blanket QWidget cream. */
QWidget#tableChipCell {
    background: transparent;
    border: none;
}

/* -- list-card headings and footers ---------------------------------- */

QLabel#warmCardTitle {
    background: transparent;
    color: #171717;
    font-size: 18px;
    font-weight: 700;
}

QLabel#warmCardCaption {
    background: transparent;
    color: #8B7F70;
    font-size: 12px;
    font-weight: 400;
}

QLabel#warmFooterRange {
    background: transparent;
    color: #6A645C;
    font-size: 12px;
    font-weight: 400;
}

/* -- payments tools --------------------------------------------------- */

QLabel#paymentsTakings {
    background: transparent;
    color: #171717;
    font-size: 13px;
    font-weight: 400;
}

QPushButton#paymentsClear {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 12px;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#paymentsClear:hover {
    background: #F6EEDC;
}

/* Inspection handovers: a cool tint for pre-rental, warm paper for post. */
QLabel#tableChip[tone="pre"] {
    background: #DDE8F4;
    color: #2F506E;
}

QLabel#tableChip[tone="post"] {
    background: #EFE9DE;
    color: #5F574C;
}

/* -- modal frame ----------------------------------------------------- */

QWidget#bookingModal,
QWidget#confirmPanel {
    background: transparent;
}

/* Plain QWidget hosts inside the white sheet must not inherit the page
   cream. QSS paints backgrounds on named QWidgets even when the Card
   underneath already painted white. */
QWidget#bookingModalHeader,
QWidget#bookingModalBody,
QWidget#warmTableFooter,
QWidget#warmFormField,
QWidget#warmFieldHost,
QWidget#warmFactRow,
QWidget#warmChipGrid,
QWidget#warmDetailColumn,
QWidget#summaryRow,
QWidget#summaryDividerHost {
    background: transparent;
    border: none;
}

QLabel#bookingEyebrow {
    background: #ECE6DD;
    border-radius: 9px;
    color: #6B5E4F;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
}

QLabel#bookingModalTitle {
    background: transparent;
    color: #161616;
    font-size: 24px;
    font-weight: 700;
}

QLabel#bookingModalSubtitle {
    background: transparent;
    color: #8B7F70;
    font-size: 13px;
    font-weight: 400;
}

QFrame#bookingModalDivider {
    background: #F5F1EA;
    border: none;
}

QFrame#bookingModalFooter {
    /* Transparent so the Card's rounded bottom corners stay visible; an
       opaque footer painted a square white block over them. */
    background: transparent;
    border: none;
    border-top: 1px solid #F5F1EA;
}

QPushButton#modalPrimary {
    background: #161616;
    border: 1px solid #161616;
    border-radius: 18px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#modalPrimary:hover {
    background: #333333;
}

QPushButton#modalSecondary {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 18px;
    color: #161616;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#modalSecondary:hover {
    background: #F6EEDC;
}

QPushButton#modalDanger {
    background: #A3271D;
    border: 1px solid #A3271D;
    border-radius: 18px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#modalDanger:hover {
    background: #8E2119;
}

QPushButton#modalPrimary:disabled,
QPushButton#modalSecondary:disabled,
QPushButton#modalDanger:disabled {
    background: #ECE6DD;
    border-color: #E0D6C9;
    color: #A79B87;
}

QLabel#modalError {
    background: #F8E0DC;
    border-radius: 8px;
    color: #9B2C1F;
    font-size: 12px;
    padding: 8px 12px;
}

/* -- modal chips ----------------------------------------------------- */

QPushButton#choiceChip {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 16px;
    color: #161616;
    font-size: 13px;
    font-weight: 500;
    padding: 0 16px;
}

QPushButton#choiceChip:hover {
    background: #F6EEDC;
}

QPushButton#choiceChip:checked {
    background: #161616;
    border-color: #161616;
    color: #FFFFFF;
}

QPushButton#choiceChip[variant="fuel"] {
    border-radius: 17px;
    padding: 0 4px;
}

QPushButton#choiceChip[variant="reason"] {
    border-radius: 24px;
    font-size: 13px;
    padding: 0 20px;
}

/* -- modal tiles, summaries, notices --------------------------------- */

QFrame#warmMetricTile {
    border: none;
    border-radius: 10px;
}

QFrame#warmMetricTile[tone="neutral"] {
    background: #ECE6DD;
}

QFrame#warmMetricTile[tone="owed"] {
    background: #F7E3C3;
}

QFrame#warmMetricTile[tone="cream"] {
    background: #F1E7D6;
}

QFrame#warmMetricTile[large="true"] {
    border-radius: 12px;
}

QLabel#metricLabel {
    background: transparent;
    color: #7D7265;
    font-size: 11px;
    font-weight: 400;
}

QLabel#metricValue {
    background: transparent;
    color: #171717;
    font-weight: 700;
}

QFrame#modalSummary {
    background: #F1E7D6;
    border: none;
    border-radius: 10px;
}

QLabel#summaryLabel {
    background: transparent;
    color: #7D7265;
    font-size: 13px;
    font-weight: 400;
}

QLabel#summaryValue {
    background: transparent;
    color: #171717;
    font-size: 13px;
    font-weight: 700;
}

QFrame#summaryDivider {
    background: #EDE3D2;
    border: none;
}

QFrame#warmNotice {
    border: none;
    border-radius: 10px;
}

QFrame#warmNotice[tone="cream"] {
    background: #F1E7D6;
}

QFrame#warmNotice[tone="red"] {
    background: #F8E0DC;
    border-radius: 8px;
}

QFrame#warmNotice[tone="green"] {
    background: #DCEFE0;
    border-radius: 8px;
}

QFrame#warmNotice[tone="amber"] {
    background: #F7E3C3;
    border-radius: 8px;
}

QLabel#warmNoticeText {
    background: transparent;
    color: #161616;
    font-size: 12px;
    font-weight: 400;
}

QLabel#warmSectionTitle {
    background: transparent;
    color: #746A5C;
    font-size: 10px;
    font-weight: 600;
}

QLabel#warmFieldLabel {
    background: transparent;
    color: #161616;
    font-size: 12px;
    font-weight: 600;
}

QLabel#warmFieldOptional {
    background: transparent;
    color: #8B7F70;
    font-size: 12px;
    font-weight: 400;
}

/* -- modal controls -------------------------------------------------- */

QLineEdit#warmInput, QDateEdit#warmInput, QComboBox#warmInput,
QSpinBox#warmInput, QDoubleSpinBox#warmInput {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 10px;
    color: #161616;
    font-size: 14px;
    min-height: 40px;
    padding: 0 12px;
}

QLineEdit#warmInput:focus, QDateEdit#warmInput:focus,
QComboBox#warmInput:focus {
    border-color: #171717;
}

QLineEdit#warmAmount {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 10px;
    color: #161616;
    font-size: 26px;
    font-weight: 700;
    min-height: 50px;
    padding: 0 16px;
}

QLineEdit#warmAmount:focus {
    border-color: #171717;
}

QLabel#warmFieldValue {
    background: transparent;
    color: #161616;
    font-size: 14px;
    font-weight: 600;
}

QLabel#warmSuffix {
    background: transparent;
    color: #8B7F70;
    font-size: 12px;
    font-weight: 400;
}

QLabel#warmAmountPrefix {
    background: transparent;
    color: #161616;
    font-size: 26px;
    font-weight: 700;
}

/* -- invoice-style amount field -------------------------------------- */

QFrame#warmAmountBox {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 10px;
}

QLineEdit#warmAmount {
    background: transparent;
    border: none;
    min-height: 0;
    padding: 0;
}

QLineEdit#warmAmount:focus {
    border: none;
}

/* Spin boxes are number inputs in the references, not steppers. */
QSpinBox#warmInput::up-button,
QSpinBox#warmInput::down-button {
    width: 0px;
    border: none;
    background: transparent;
}

QDateEdit#warmInput::drop-down {
    border: none;
    background: transparent;
    width: 24px;
}

/* Filter toggles read as outline pills, matching the chip row. */
QPushButton#warmCheck {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 16px;
    color: #171717;
    font-size: 12px;
    font-weight: 500;
    padding: 0 14px;
}

QPushButton#warmCheck:hover {
    background: #F6EEDC;
}

QPushButton#warmCheck:checked {
    background: #171717;
    border-color: #171717;
    color: #FFFFFF;
}

QPushButton#warmCheck:disabled {
    background: #F1E8D8;
    color: #A79B87;
}
QPushButton#warmLoadMore {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 18px;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#warmLoadMore:hover {
    background: #F6EEDC;
}

QPushButton#choiceChip[variant="reason"] {
    padding: 0 12px;
    text-align: center;
}


QPushButton#warmCheck {
    min-height: 30px;
}

/* ======================================================================
   MAINTENANCE ACTION MODALS
   Warm 540px History / Mark completed sheets and the 900px Log maintenance
   sheet. Scoped to #maintenanceSheet so the list page, the rental wizard,
   and every other modal keep their existing measurements.
   ====================================================================== */

QWidget#maintenanceSheet,
QWidget#maintenanceSheetHeader,
QWidget#maintenanceSheetBody,
QWidget#maintenanceColumn,
QWidget#maintenanceRightColumn,
QWidget#maintenanceFieldHost,
QWidget#maintenanceSummaryRow {
    background: transparent;
    border: none;
}

QFrame#maintenanceCard {
    background: transparent;
    border: none;
    border-radius: 18px;
}

QLabel#maintenanceEyebrow {
    background: #F0E6D5;
    border-radius: 11px;
    color: #6B5E4F;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 12px;
}

QLabel#maintenanceEyebrowPlain {
    background: transparent;
    color: #6B5E4F;
    font-size: 13px;
    font-weight: 500;
}

QLabel#maintenanceTitle {
    background: transparent;
    color: #171717;
    font-size: 26px;
    font-weight: 700;
}

QLabel#maintenanceTitle[large="true"] {
    font-size: 30px;
}

QLabel#maintenanceSubtitle {
    background: transparent;
    color: #6B5E4F;
    font-size: 13px;
    font-weight: 400;
}

QFrame#maintenanceDivider {
    background: #EFE8DD;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#maintenanceFooter {
    background: transparent;
    border: none;
    border-top: 1px solid #F1EAE0;
}

QLabel#maintenanceError {
    background: #F8E0DC;
    border-radius: 8px;
    color: #9B2C1F;
    font-size: 12px;
    padding: 8px 12px;
}

QLabel#maintenanceSectionLabel {
    background: transparent;
    color: #7A6F61;
}

QLabel#maintenanceFieldSuffix,
QLabel#maintenanceFieldOptional {
    background: transparent;
    color: #8B7F70;
    font-size: 13px;
    font-weight: 400;
}

/* -- History metrics and cards --------------------------------------- */

QFrame#maintenanceMetricTile {
    background: #F3EAD9;
    border: none;
    border-radius: 14px;
}

QLabel#maintenanceMetricLabel {
    background: transparent;
    color: #6B5E4F;
    font-size: 13px;
    font-weight: 400;
}

QLabel#maintenanceMetricValue {
    background: transparent;
    color: #171717;
    font-size: 26px;
    font-weight: 700;
}

QFrame#maintenanceRecordCard {
    background: #FFFFFF;
    border: 1px solid #E4D9CA;
    border-radius: 14px;
}

QLabel#maintenanceRecordType {
    background: transparent;
    color: #171717;
    font-size: 15px;
    font-weight: 700;
}

QLabel#maintenanceRecordMeta,
QLabel#maintenanceRecordDue {
    background: transparent;
    color: #6B5E4F;
    font-size: 13px;
    font-weight: 400;
}

QLabel#maintenanceRecordBody {
    background: transparent;
    color: #171717;
    font-size: 14px;
}

/* -- Log maintenance ------------------------------------------------- */

QWidget#maintenanceSheet QLineEdit#warmInput,
QWidget#maintenanceSheet QDateEdit#warmInput,
QWidget#maintenanceSheet QComboBox#warmInput,
QWidget#maintenanceSheet QSpinBox#warmInput {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 12px;
    color: #171717;
    font-size: 14px;
    min-height: 40px;
    padding: 0 14px;
}

QWidget#maintenanceSheet QLineEdit#warmInput:focus,
QWidget#maintenanceSheet QDateEdit#warmInput:focus,
QWidget#maintenanceSheet QComboBox#warmInput:focus,
QWidget#maintenanceSheet QSpinBox#warmInput:focus {
    border-color: #171717;
}

QWidget#maintenanceSheet QDateEdit#warmInput::drop-down,
QWidget#maintenanceSheet QComboBox#warmInput::drop-down {
    border: none;
    background: transparent;
    width: 24px;
}

QLabel#maintenanceEndPlaceholder {
    background: #F8F1E5;
    border: 1px dashed #D7C7B0;
    border-radius: 12px;
    color: #8B7F70;
    font-size: 14px;
    padding: 0 14px;
}
QFrame#maintenanceSummary {
    background: #F3EAD9;
    border: none;
    border-radius: 16px;
}

QLabel#maintenanceSummaryTitle {
    background: transparent;
    color: #171717;
    font-size: 17px;
    font-weight: 700;
}

QLabel#maintenanceSummaryValue {
    background: transparent;
    color: #171717;
    font-size: 13px;
    font-weight: 700;
}

QFrame#maintenanceSummaryRule {
    background: #E9DDCB;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#maintenanceNotice {
    background: #FAE7C8;
    border: none;
    border-radius: 16px;
}

QLabel#maintenanceNoticeTitle {
    background: transparent;
    color: #5F4413;
    font-size: 14px;
    font-weight: 700;
}

QLabel#maintenanceNoticeText {
    background: transparent;
    color: #5F4413;
    font-size: 13px;
    font-weight: 400;
}

/* -- Mark completed: optional next service --------------------------- */

QFrame#maintenanceNextPanel {
    background: #F3EAD9;
    border: none;
    border-radius: 16px;
}

QWidget#maintenanceSheet QDateEdit#nextServiceInput,
QWidget#maintenanceSheet QSpinBox#nextServiceInput {
    background: #F8F1E5;
    border: 1px solid #E3D5C2;
    border-radius: 12px;
    color: #171717;
    font-size: 14px;
    min-height: 40px;
    padding: 0 14px;
}

QWidget#maintenanceSheet QDateEdit#nextServiceInput:disabled,
QWidget#maintenanceSheet QSpinBox#nextServiceInput:disabled {
    background: #F8F1E5;
    border: 1px dashed #D7C7B0;
    color: #6B5E4F;
}

QWidget#maintenanceSheet QDateEdit#nextServiceInput::drop-down {
    border: none;
    background: transparent;
    width: 24px;
}

QWidget#maintenanceSheet QSpinBox#nextServiceInput::up-button,
QWidget#maintenanceSheet QSpinBox#nextServiceInput::down-button {
    width: 0px;
    border: none;
    background: transparent;
}

/* ===================================================================
   FLEET MODALS (Add/Edit vehicle + Vehicle details)
   The references are a 900px white sheet on the frosted app backdrop:
   cream preview/spec panels, warm inputs, chip selectors, and an ink
   primary action in a sticky footer. Scoped by object name so the rest
   of the staff app keeps its existing control geometry.
   =================================================================== */

QWidget#fleetModal,
QWidget#fleetModalHeader,
QWidget#fleetModalBody,
QWidget#fleetFieldHost {
    background: transparent;
    border: none;
}

/* Card paints its own rounded white fill; the QSS class rule must not
   square off the corners behind it. */
QFrame#fleetModalCard {
    background: transparent;
    border: none;
}

QLabel#fleetEyebrow {
    background: #ECE6DD;
    border-radius: 9px;
    color: #6B5E4F;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
}

QLabel#fleetModalTitle {
    background: transparent;
    color: #171717;
    font-size: 30px;
    font-weight: 700;
}

QLabel#fleetModalSubtitle {
    background: transparent;
    color: #7D7265;
    font-size: 13px;
    font-weight: 400;
}

QFrame#fleetModalRule {
    background: #EDE5D8;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#fleetModalFooter {
    /* Transparent so Card's rounded bottom corners stay visible. */
    background: transparent;
    border: none;
    border-top: 1px solid #EDE5D8;
}

QFrame#fleetModalCard QPushButton#primaryButton,
QFrame#fleetModalCard QPushButton#secondaryButton {
    border-radius: 18px;
    font-size: 13px;
    font-weight: 600;
    padding: 0 20px;
}

QFrame#fleetModalCard QPushButton#primaryButton {
    background: #171717;
    border: 1px solid #171717;
    color: #FFFFFF;
}

QFrame#fleetModalCard QPushButton#primaryButton:hover {
    background: #333333;
    border-color: #333333;
}

QFrame#fleetModalCard QPushButton#secondaryButton {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    color: #171717;
}

QFrame#fleetModalCard QPushButton#secondaryButton:hover {
    background: #F6EEDC;
    border-color: #C6B8A3;
}

QFrame#fleetModalCard QPushButton#primaryButton:disabled,
QFrame#fleetModalCard QPushButton#secondaryButton:disabled {
    background: #ECE6DD;
    border-color: #E0D6C9;
    color: #A79B87;
}

/* -- cream preview panel -------------------------------------------- */

QFrame#fleetPreview {
    background: #EFE6D5;
    border: 1px solid #E7DBC7;
    border-radius: 14px;
}

/* -- details panels and rows ---------------------------------------- */

QLabel#fleetHero {
    background: #EEEAE1;
    border: none;
    border-radius: 14px;
    color: #8A8175;
    font-size: 13px;
}

QLabel#fleetThumb {
    background: #EEEAE1;
    border: 1px solid #E0D6C9;
    border-radius: 10px;
    color: #8A8175;
    font-size: 11px;
}

QLabel#fleetThumb[selected="true"] {
    border: 2px solid #171717;
}

QLabel#fleetViewerPlaceholder {
    background: #EEEAE1;
    border: none;
    border-radius: 14px;
    color: #8A8175;
    font-size: 13px;
}

QFrame#fleetHistoryRow {
    background: transparent;
    border: none;
}

QFrame#fleetRowRule {
    background: #EFE8DC;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QLabel#fleetMetaChip {
    background: #EDE6D9;
    border: none;
    border-radius: 11px;
    color: #6B5E4F;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
}

QProgressBar#fleetUtilBar {
    background: #EDE6D9;
    border: none;
    border-radius: 4px;
}

QProgressBar#fleetUtilBar::chunk {
    background: #171717;
    border-radius: 4px;
}

/* -- track-expiry checkbox ------------------------------------------ */

QCheckBox#fleetCheck {
    background: transparent;
    color: #3F3A33;
    font-size: 12px;
    spacing: 8px;
}

QCheckBox#fleetCheck::indicator {
    width: 16px;
    height: 16px;
    background: #FFFFFF;
    border: 1px solid #CFC3B2;
    border-radius: 4px;
}

QCheckBox#fleetCheck::indicator:checked {
    background: #171717;
    border-color: #171717;
}

/* ======================================================================
   CUSTOMER MODALS (add/edit, profile, settle)
   The counter's warm paper language at the reference's 900px width:
   white rounded sheet, pill eyebrow, large title, two columns, cream
   preview/metric surfaces, dashed licence boxes, sticky footer.
   Scoped to the customer modal so Fleet/Bookings keep their own sheets.
   ====================================================================== */

QWidget#customerModal,
QWidget#customerModalHeader,
QWidget#customerModalBody,
QWidget#customerField,
QWidget#customerFacts,
QWidget#customerPreviewColumn,
QWidget#customerPreviewRow,
QWidget#customerNotesHost,
QWidget#customerTabPage,
QWidget#customerStatusCell,
QWidget#customerProfileColumn,
QWidget#settleColumn {
    background: transparent;
    border: none;
}

QFrame#customerModalFooter {
    background: transparent;
    border: none;
    border-top: 1px solid #F1EBE1;
}

QLabel#customerEyebrow {
    background: #F0EAE0;
    border-radius: 10px;
    color: #6B5E4F;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
}

QLabel#customerModalTitle {
    background: transparent;
    color: #171717;
    font-size: 28px;
    font-weight: 700;
}

QLabel#customerModalSubtitle {
    background: transparent;
    color: #8B7F70;
    font-size: 13px;
    font-weight: 400;
}

QFrame#customerModalDivider {
    background: #F1EBE1;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QLabel#customerSectionLabel {
    background: transparent;
    color: #7D7265;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.7px;
}

QLabel#customerFieldLabel {
    background: transparent;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
}

QLabel#customerFieldOptional {
    background: transparent;
    color: #8B7F70;
    font-size: 12px;
    font-weight: 400;
}

QLineEdit#customerInput,
QDateEdit#customerInput {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 10px;
    color: #171717;
    font-size: 14px;
    min-height: 40px;
    padding: 0 12px;
}

QLineEdit#customerInput:focus,
QDateEdit#customerInput:focus {
    border-color: #171717;
}

QDateEdit#customerInput::drop-down {
    border: none;
    background: transparent;
    width: 24px;
}

QLabel#customerDuplicateWarning {
    background: #F8E0DC;
    border-radius: 8px;
    color: #9B2C1F;
    font-size: 11px;
    padding: 7px 10px;
}

QLabel#customerDuplicateWarning:empty {
    background: transparent;
    padding: 0;
}

/* -- source / method chips ------------------------------------------- */

QPushButton#sourceChip,
QPushButton#settleMethod {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 10px;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
    padding: 0 14px;
}

QPushButton#sourceChip:hover,
QPushButton#settleMethod:hover {
    background: #F6EEDC;
}

QPushButton#sourceChip:checked,
QPushButton#settleMethod:checked {
    background: #171717;
    border-color: #171717;
    color: #FFFFFF;
}

/* -- preview panel --------------------------------------------------- */

QFrame#customerPreview {
    background: #F1E8D8;
    border: 1px solid #EADFCF;
    border-radius: 16px;
}

QLabel#customerAvatar,
QLabel#customerAvatarLarge {
    background: #EADBBB;
    border-radius: 29px;
    color: #171717;
    font-size: 18px;
    font-weight: 700;
}

QLabel#customerPreviewName {
    background: transparent;
    color: #171717;
    font-size: 18px;
    font-weight: 700;
}

QFrame#customerPreviewRule {
    background: #E4D7C4;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QLabel#customerFactKey {
    background: transparent;
    color: #7D7265;
    font-size: 12px;
    font-weight: 400;
}

QLabel#customerFactValue {
    background: transparent;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
}

QFrame#customerLicenceNotice {
    background: #F7E3C3;
    border: none;
    border-radius: 12px;
}

QLabel#customerNoticeText {
    background: transparent;
    color: #171717;
    font-size: 12px;
}

/* -- dashed licence photo boxes -------------------------------------- */

QPushButton#docBox {
    background: #FFFFFF;
    border: 1px dashed #D8CCBB;
    border-radius: 10px;
    color: #171717;
    text-align: center;
}

QPushButton#docBox:hover {
    background: #FBF7F0;
    border-color: #B8A68A;
}

QPushButton#docBox:disabled {
    background: #FBF8F2;
    border-color: #E7DED0;
}

QLabel#docBoxPreview {
    background: transparent;
    border: none;
}

QLabel#docBoxTitle {
    background: transparent;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
}

QLabel#docBoxSubtitle {
    background: transparent;
    color: #8B7F70;
    font-size: 11px;
    font-weight: 400;
}

/* -- profile --------------------------------------------------------- */

QLabel#customerProfileName {
    background: transparent;
    color: #171717;
    font-size: 24px;
    font-weight: 700;
}

QLabel#customerProfileMeta,
QLabel#customerProfileContact {
    background: transparent;
    color: #8B7F70;
    font-size: 12px;
    font-weight: 400;
}

QFrame#customerActivityStrip {
    background: #F5EFE4;
    border: none;
    border-top: 1px solid #F1E8D8;
    border-bottom: 1px solid #F1E8D8;
}

QFrame#customerActivityTile {
    border: none;
    border-radius: 10px;
}

QFrame#customerActivityTile[tone="amber"] {
    background: #F7E3C3;
}

QFrame#customerActivityTile[tone="plain"] {
    background: #FFFFFF;
    border: 1px solid #ECE4D8;
}

QLabel#customerActivityTitle {
    background: transparent;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
}

QLabel#customerActivityDetail {
    background: transparent;
    color: #171717;
    font-size: 12px;
}

QFrame#customerMetricTile {
    background: #ECE6DD;
    border: none;
    border-radius: 10px;
}

QLabel#customerMetricLabel {
    background: transparent;
    color: #7D7265;
    font-size: 11px;
}

QLabel#customerMetricValue {
    background: transparent;
    color: #171717;
    font-size: 18px;
    font-weight: 700;
}

QFrame#customerOwedBanner {
    border: none;
    border-radius: 12px;
}

QFrame#customerOwedBanner[tone="owed"] {
    background: #F8E0DC;
}

QFrame#customerOwedBanner[tone="clear"] {
    background: #E4F1E4;
}

QLabel#customerOwedLabel {
    background: transparent;
    font-size: 13px;
    font-weight: 600;
}

QLabel#customerOwedAmount {
    background: transparent;
    font-size: 22px;
    font-weight: 700;
}

/* -- profile tabs and tables ---------------------------------------- */

QTabWidget#customerTabs,
QTabWidget#customerTabs QTabBar,
QTabWidget#customerTabs QStackedWidget,
QTabWidget#customerTabs QWidget#customerTabPage {
    background: transparent;
    border: none;
}

QTabWidget#customerTabs::pane {
    background: transparent;
    border: none;
    border-top: 1px solid #F1EBE1;
}

QTabWidget#customerTabs QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #7D7265;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 12px;
    margin-right: 4px;
}

QTabWidget#customerTabs QTabBar::tab:hover {
    color: #171717;
}

QTabWidget#customerTabs QTabBar::tab:selected {
    color: #171717;
    border-bottom: 2px solid #171717;
}

QTableWidget#customerBookingsTable {
    background: transparent;
    alternate-background-color: transparent;
    border: none;
    gridline-color: #F0EBE2;
    font-size: 12px;
    selection-background-color: transparent;
}

QTableWidget#customerBookingsTable::item {
    border-bottom: 1px solid #F0EBE2;
    color: #171717;
    padding: 0 6px;
}

QTableWidget#customerBookingsTable QHeaderView::section {
    background: #EEEAE1;
    border: none;
    color: #6F685E;
    font-size: 11px;
    font-weight: 600;
    padding: 7px 6px;
}

QTableWidget#customerBookingsTable QHeaderView::section:first {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
}

QTableWidget#customerBookingsTable QHeaderView::section:last {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QFrame#customerIncidentRow {
    background: #FFFFFF;
    border: 1px solid #F0EBE2;
    border-radius: 8px;
}

/* -- settle ---------------------------------------------------------- */

QFrame#settleAmountBox {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 10px;
}

QLabel#settleAmountPrefix {
    background: transparent;
    color: #171717;
    font-size: 18px;
    font-weight: 700;
}

QLineEdit#settleAmountInput {
    background: transparent;
    border: none;
    color: #171717;
    font-size: 18px;
    font-weight: 700;
    padding: 0;
}

QLineEdit#settleAmountInput:focus {
    border: none;
}

QPushButton#settlePayAll {
    background: transparent;
    border: none;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
    padding: 0;
    text-align: left;
    text-decoration: underline;
}

QPushButton#settlePayAll:hover {
    color: #6B5E4F;
}

QLabel#settleRefHint {
    background: transparent;
    color: #8B7F70;
    font-size: 11px;
}

QPushButton#settleBooking {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 12px;
    text-align: left;
}

QPushButton#settleBooking:hover {
    background: #FBF7F0;
}

QPushButton#settleBooking:checked {
    border: 1px solid #171717;
}

QLabel#settleRef {
    background: transparent;
    color: #171717;
    font-size: 14px;
    font-weight: 700;
}

QLabel#settleOwed {
    background: transparent;
    color: #7D7265;
    font-size: 11px;
}

QLabel#settleCheck {
    background: transparent;
    border: 1px solid #C9BCA6;
    border-radius: 6px;
    color: transparent;
    font-size: 12px;
    font-weight: 700;
}

QLabel#settleCoverage {
    background: transparent;
    border: none;
    border-radius: 9px;
    color: #7D7265;
    font-size: 11px;
    padding: 3px 9px;
}

QLabel#settleCoverage[state="full"] {
    background: #DCEEDC;
    color: #3F6D4E;
}

QLabel#settleCoverage[state="partial"] {
    background: #F7E3C3;
    color: #8A6523;
}

QFrame#settleSummary {
    background: #F1E7D6;
    border: none;
    border-radius: 12px;
}

QFrame#settleSummaryRule {
    background: #E4D7C4;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QLabel#settleTotal {
    background: transparent;
    color: #171717;
    font-size: 14px;
    font-weight: 700;
}

/* ======================================================================
   REPORTS WORKSPACE
   Scoped to report* object names and the warm metric "report" variant so
   Dashboard, Settings, and the list pages are untouched.
   ====================================================================== */

QComboBox#reportPreset,
QComboBox#reportFilter,
QDateEdit#reportDate {
    background: #FFFFFF;
    border: 1px solid #DCD0C0;
    border-radius: 8px;
    color: #171717;
    font-size: 13px;
    padding: 4px 10px;
}

QComboBox#reportPreset:hover,
QComboBox#reportFilter:hover,
QDateEdit#reportDate:hover {
    border-color: #C9BCA6;
}

QComboBox#reportPreset::drop-down,
QComboBox#reportFilter::drop-down,
QDateEdit#reportDate::drop-down {
    border: none;
    background: transparent;
    width: 22px;
}

QPushButton#reportExportPdf {
    background: #171717;
    border: 1px solid #171717;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#reportExportPdf:hover {
    background: #333333;
    border-color: #333333;
}

QPushButton#reportExportCsv {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 8px;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#reportExportCsv:hover {
    background: #F6EEDC;
    border-color: #C9BCA6;
}

QFrame#reportChartCard {
    background: #FFFFFF;
    border: 1px solid #E9DFD1;
    border-radius: 14px;
}

QWidget#reportMetricGrid,
QWidget#reportMetricRow,
QWidget#reportTableFooter {
    background: transparent;
    border: none;
}

QLabel#reportSummary {
    background: transparent;
    color: #7D7265;
    font-size: 12px;
}

QLabel#reportFooterCount {
    background: transparent;
    color: #6A645C;
    font-size: 12px;
}

QFrame#warmMetricTile[tone="highlight"] {
    background: #EADBBB;
}

QFrame#warmMetricTile[tone="report"] {
    background: #EFE6D7;
}

QFrame#warmMetricTile[report="true"] {
    border-radius: 12px;
}

QFrame#warmMetricTile[report="true"] QLabel#metricLabel {
    color: #7D7265;
    font-size: 12px;
}

QFrame#warmMetricTile[report="true"] QLabel#metricValue {
    color: #171717;
    font-size: 20px;
    font-weight: 700;
}

QCheckBox#reportOverdue {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 18px;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
    padding: 0 14px;
    spacing: 7px;
}

QCheckBox#reportOverdue:hover {
    background: #F6EEDC;
}

QCheckBox#reportOverdue::indicator {
    width: 9px;
    height: 9px;
    border: 1px solid #C07B72;
    border-radius: 5px;
    background: #C07B72;
}

QCheckBox#reportOverdue::indicator:checked {
    background: #A8452F;
    border-color: #A8452F;
}

/* ======================================================================
   SETTINGS
   Warm Settings cards: left title/tag rail + right control column, plus
   the Add staff, Reset password, and Accent color sheets. Scoped by
   object name so the rest of the app keeps its existing surfaces.
   ====================================================================== */

QWidget#settingsCardRail,
QWidget#settingsField,
QWidget#settingsFieldHost {
    background: transparent;
    border: none;
}

QLabel#settingsCardTitle {
    background: transparent;
    color: #171717;
    font-size: 18px;
    font-weight: 700;
}

QLabel#settingsCardCaption {
    background: transparent;
    color: #8B7F70;
    font-size: 12px;
    font-weight: 400;
}

QLabel#settingsTag {
    background: #ECE6DD;
    border-radius: 9px;
    color: #6B5E4F;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
}

QLabel#settingsFieldLabel {
    background: transparent;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
}

QLabel#settingsHint {
    background: transparent;
    color: #8B7F70;
    font-size: 12px;
    font-weight: 400;
}

QLabel#settingsAdminNote {
    background: transparent;
    color: #8B7F70;
    font-size: 13px;
    font-weight: 400;
}

QLabel#settingsPreview {
    background: #F1E7D6;
    border-radius: 10px;
    color: #171717;
    font-size: 13px;
    font-weight: 500;
    padding: 0 14px;
}

QLabel#settingsEmailValue {
    background: #F1E7D6;
    border-radius: 10px;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
    min-height: 40px;
    padding: 0 14px;
}

QPushButton#settingsPrimary {
    background: #171717;
    border: 1px solid #171717;
    border-radius: 18px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#settingsPrimary:hover {
    background: #333333;
}

QPushButton#settingsSecondary {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 18px;
    color: #171717;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#settingsSecondary:hover {
    background: #F6EEDC;
}

QPushButton#settingsDanger {
    background: #FFFFFF;
    border: 1px solid #C07B72;
    border-radius: 18px;
    color: #9B2C1F;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

QPushButton#settingsDanger:hover {
    background: #F8E0DC;
}

QPushButton#settingsPrimary:disabled,
QPushButton#settingsSecondary:disabled,
QPushButton#settingsDanger:disabled {
    background: #EADBBB;
    border-color: #DCCBAA;
    color: #A79B87;
}

QPushButton#settingsInline {
    background: #FFFFFF;
    border: 1px solid #E0D6C9;
    border-radius: 16px;
    color: #171717;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
}

QPushButton#settingsInline:hover {
    background: #F6EEDC;
}

QCheckBox#settingsCheck {
    background: transparent;
    color: #171717;
    font-size: 13px;
    spacing: 8px;
}

QLabel#settingsAccentPreview {
    min-height: 40px;
}

QLabel#settingsContrast {
    background: transparent;
    color: #8B7F70;
    font-size: 12px;
}

QSlider#accentSlider {
    min-height: 30px;
}

QSlider#accentSlider::groove:horizontal {
    height: 14px;
    border-radius: 7px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #EF3E36,
        stop: 0.17 #F5D43A,
        stop: 0.34 #4ED26B,
        stop: 0.50 #2FD3C4,
        stop: 0.67 #2A6BEA,
        stop: 0.84 #7B3FE4,
        stop: 1 #D6298A
    );
}

QSlider#accentSlider::handle:horizontal {
    width: 24px;
    margin: -7px 0;
    border-radius: 12px;
    background: #FFFFFF;
    border: 3px solid #171717;
}

QSpinBox#warmInput:focus,
QDoubleSpinBox#warmInput:focus {
    border-color: #171717;
}

QDoubleSpinBox#warmInput::up-button,
QDoubleSpinBox#warmInput::down-button {
    width: 0px;
    border: none;
    background: transparent;
}

QWidget#bookingModal[variant="settings"] QLabel#bookingModalTitle {
    font-size: 26px;
}

QWidget#bookingModal[variant="settings"] QLabel#warmFieldLabel {
    font-size: 13px;
}
