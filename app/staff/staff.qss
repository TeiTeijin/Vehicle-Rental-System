/* STAFF APP
   Same palette as the customer app (app/ui/styles.qss) so the two windows
   look like one product, plus the semantic colours the operations screens
   need. Object names are defined in app/staff/theme.py and set from Python,
   because a mistyped selector here fails silently.
*/

QMainWindow, QWidget {
    background: #F1E8D8;
    color: #1A1A1A;
    font-family: "Inter 18pt";
}

QWidget#page {
    background: #F1E8D8;
}

/* THE PAGE SHEET
   The dashboard lays its title and its five cards on one white rounded sheet
   over the cream page. The radius is PAGE_PANEL_RADIUS, deliberately larger
   than a card's, so the sheet and the cards on it read as nested shapes rather
   than the same box twice. The scroll area and its content have to be told to
   paint nothing: the blanket `QWidget { background: #F1E8D8 }` above matches
   them too and would otherwise draw a cream block inside the white sheet. */
QFrame#pagePanel {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 36px;
}

QScrollArea, #pageViewport, #pageContent {
    background: transparent;
}

/* The header is a plain `QWidget`, so the blanket cream above would paint a
   cream band across the top of the white sheet. Its two labels are already
   transparent from Python. Harmless on the unpanelled pages, whose page is
   cream anyway. */
QWidget#pageHeader {
    background: transparent;
}


/* SIDEBAR
   The floating navigation panel. Each row (icon, label, hover tint and the
   active leading bar) is painted by `NavItem`, so this dresses only the panel
   and its two labels -- a background or border on the row would fight the
   painted hover tint. The radius matches SIDEBAR_RADIUS in metrics.py.

   `#sidebarList` has to be told to paint nothing, for the same reason
   `#loginForm` below is: the blanket `QWidget { background: #F1E8D8 }` at the
   top of this file matches it and draws a cream panel straight over the white
   sidebar. The scrollbar is hidden outright rather than merely left unstyled,
   because a bar down the edge of a floating panel reads as an unfinished
   frame; the wheel still scrolls it. */

QFrame#sidebar {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 28px;
}

QFrame#sidebar QScrollBar:vertical {
    width: 0px;
    background: transparent;
    margin: 0;
}

QFrame#sidebar QScrollBar::handle:vertical {
    background: transparent;
}

QLabel#sidebarWordmark {
    background: transparent;
    color: #171717;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

QLabel#sidebarGroup {
    background: transparent;
    color: #6F6759;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

#sidebarList {
    background: transparent;
}

#sidebarItem {
    background: transparent;
    border: none;
}

QPushButton#ghostButton {
    background: #EEEAE1;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#ghostButton:hover {
    background: #E6E1D6;
    border-color: #C9BCA6;
}

QPushButton#ghostButton:disabled {
    color: #C4BBA9;
    border-color: #D8CCBB;
}

/* DEMO BANNER
   Deliberately loud. The only realistic way to end up reconciling against
   fiction is to forget which database is open, so the window says so. */

QFrame#demoBanner {
    background: #B07D2B;
    border: none;
}

QLabel#demoBannerText {
    background: transparent;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
}

/* PAGE CHROME */

QLabel#pageTitle {
    background: transparent;
    font-size: 22px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    background: transparent;
    color: #8A8175;
    font-size: 13px;
}

/* TABLE STATES
   An empty table is ambiguous: it can mean "no rows" or "the query failed".
   The failure state gets its own colour and its own retry button. */

QTableView {
    background: #FFFFFF;
    alternate-background-color: #FAF6EF;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
    gridline-color: #EDE6D9;
    selection-background-color: #EDE6D9;
    selection-color: #1A1A1A;
    font-size: 13px;
}

QHeaderView::section {
    background: #EEEAE1;
    border: none;
    border-bottom: 1px solid #D8CCBB;
    padding: 9px 8px;
    font-size: 12px;
    font-weight: 700;
}

QTableView QTableCornerButton::section {
    background: #EEEAE1;
    border: none;
}

QLabel#emptyState {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
    color: #8A8175;
    font-size: 14px;
}

QLabel#errorState {
    background: #FFFFFF;
    border: 1px solid #A8452F;
    border-radius: 6px;
    color: #A8452F;
    font-size: 14px;
    font-weight: 600;
}

QLabel#errorDetail {
    background: transparent;
    color: #8A8175;
    font-size: 12px;
}

QPushButton#retryButton {
    background: #A8452F;
    border: 1px solid #A8452F;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 7px 18px;
}

QPushButton#retryButton:hover {
    background: #903926;
    border-color: #903926;
}

/* STATUS PILL
   Background is set from Python via colour_for() in theme.py, because the
   colour depends on the value and a stylesheet cannot select on cell text. */

QLabel#statusPill {
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 700;
}

/* INPUTS */

QLineEdit, QDateEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    selection-background-color: #D8CCBB;
    selection-color: #1A1A1A;
}

QLineEdit:focus, QDateEdit:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QTextEdit:focus {
    border: 1px solid #171717;
}

QLineEdit:disabled, QDateEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QTextEdit:disabled {
    background: #F4EFE5;
    color: #C4BBA9;
}

/* An inline validation error, shown under the field that caused it. */
QLabel#fieldError {
    background: transparent;
    color: #A8452F;
    font-size: 12px;
    font-weight: 600;
}

QLabel#fieldLabel {
    background: transparent;
    color: #8A8175;
    font-size: 12px;
    font-weight: 600;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    selection-background-color: #EDE6D9;
    selection-color: #1A1A1A;
    outline: none;
}

/* BUTTONS */

QPushButton#primaryButton {
    background: #1A1A1A;
    border: 1px solid #1A1A1A;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
}

QPushButton#primaryButton:hover {
    background: #171717;
    border-color: #171717;
}

QPushButton#primaryButton:disabled {
    background: #C4BBA9;
    border-color: #C4BBA9;
    color: #FFFFFF;
}

QPushButton#secondaryButton {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 6px;
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 18px;
}

QPushButton#secondaryButton:hover {
    background: #F4EFE5;
    border-color: #C9BCA6;
}

QPushButton#dangerButton {
    background: #FFFFFF;
    border: 1px solid #A8452F;
    border-radius: 6px;
    color: #A8452F;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
}

QPushButton#dangerButton:hover {
    background: #A8452F;
    color: #FFFFFF;
}

/* LOGIN

   Flat: no panel, no shadow, no card. The window behind this is already one
   surface, and a card on it read as a different object dropped in the middle.
   The wordmark is the only large type on the screen. */

QWidget#loginRoot {
    background: #FFFFFF;
}

/* The form column. It has to be told to paint nothing, because the blanket
   `QWidget { background: #F1E8D8 }` at the top of this file matches it -- it
   has no object name of its own to override it with -- and it then draws a
   cream panel straight over the white page. */
QWidget#loginForm {
    background: transparent;
}

QLabel#loginWordmark {
    background: transparent;
    color: #171717;
    font-size: 32px;
    font-weight: 700;
}

QLabel#loginCaption {
    background: transparent;
    color: #9B978F;
    font-size: 16px;
    font-weight: 400;
}

/* A field is a rule, not a box. The label floats above the rule when the field
   is in use, so the rule carries the whole affordance and gets heavier on
   focus. Padding is asymmetric on purpose: the lifted label needs the room. */
QLineEdit#loginField {
    background: transparent;
    border: none;
    border-bottom: 1px solid #CFC6B5;
    border-top: 20px solid transparent;
    color: #171717;
    font-size: 15px;
    padding: 6px 1px;
    /* Selected text is ink on sand. The sand is far too light to carry white
       text -- that pairing measures 1.42:1 -- so the ink flips instead. */
    selection-background-color: #E5D7BE;
    selection-color: #171717;
}

QLineEdit#loginField:focus {
    border-bottom: 2px solid #E5D7BE;
    padding-bottom: 5px;
}

/* The eye inside the field. It paints its own icon and nothing else, so it is
   told outright not to take a background. Today the custom paintEvent never
   calls up to QStyle, so nothing would fill it anyway -- but the global
   QWidget rule fills this page with cream, and the moment anyone adds
   `super().paintEvent()` for a hover background this becomes a cream square
   behind the icon. The same trap took the form column out earlier. */
QAbstractButton#loginReveal {
    background: transparent;
    border: none;
}

/* Down, this is the placeholder sitting in the field. */
QLabel#loginLabel {
    background: transparent;
    color: #9B978F;
    font-size: 16px;
    font-weight: 400;
}

/* Up, it has become a label, so it is smaller and takes the accent.

   A darker shade of the button's sand rather than the sand itself: at 12px
   this has to clear 4.5:1, and #E5D7BE on white is 1.42:1 -- invisible. This
   is 4.84:1 and still reads as the same colour. */
QLabel#loginLabelLifted {
    background: transparent;
    color: #8A6D3F;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#loginButton {
    background: #E5D7BE;
    border: 1px solid #E5D7BE;
    border-radius: 6px;
    color: #171717;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 18px;
}

QPushButton#loginButton:hover {
    background: #DCCBAE;
    border-color: #DCCBAE;
}

QPushButton#loginButton:pressed {
    background: #CDB994;
    border-color: #CDB994;
}

QPushButton#loginButton:disabled {
    background: #E6DFD2;
    border-color: #E6DFD2;
    color: #A9A296;
}

QLabel#loginError {
    background: #FDF0ED;
    border: 1px solid #C0563A;
    border-left: 3px solid #A8452F;
    border-radius: 4px;
    color: #8E3A28;
    font-size: 13px;
    font-weight: 500;
    padding: 9px 11px;
}

QLabel#loginFoot {
    background: transparent;
    color: #9B978F;
    font-size: 12px;
}

/* TOAST
   Non-blocking confirmation. Anchored bottom-right by app/staff/feedback.py. */

QFrame#toast {
    background: #1A1A1A;
    border: none;
    border-radius: 6px;
}

QLabel#toastText {
    background: transparent;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
}

QLabel#toastText[kind="ok"] {
    color: #B9D4C1;
}

QLabel#toastText[kind="error"] {
    color: #F0BFB2;
}

/* DIALOGS */

QDialog {
    background: #F1E8D8;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #D8CCBB;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #C9BCA6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #D8CCBB;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* DASHBOARD
   The card system. Radius and padding are the numbers in app/staff/metrics.py;
   tests/test_staff_dashboard.py asserts this file agrees with them, because a
   QSS value cannot be read back at runtime and a mismatch is invisible until
   two cards sit next to each other.

   Two variants off one selector, selected by the `dark` property rather than
   an object name: a dark card is still a card, and the widgets are built the
   same way either way.
*/

QFrame[class="card"] {
    border-radius: 28px;
    border: 1px solid #D8CCBB;
    background: #FFFFFF;
}

QFrame[class="card"][dark="true"] {
    border-radius: 28px;
    /* No border on the dark cards. A one-pixel outline the same family as the
       ink reads as a hairline of lighter grey around the edge, which is the
       thing that makes a flat dark panel look like a UI element rather than a
       hole; the brief's own flat cards have none. */
    border: none;
    background: #171717;
}

QFrame[class="card"][hover="true"] {
    background: #302F2D;
}

/* The revenue card's day picker. A combo so every day is reachable, dressed as
   a pill so it still reads as one control rather than a form field dropped into
   the card. The radius and min-height set the pill, and the drop-down keeps the
   platform arrow so it is obvious it opens. */
QComboBox#revenuePeriod {
    background: #EEEAE1;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 2px 6px 2px 12px;
    min-height: 24px;
    font-size: 12px;
    font-weight: 600;
    color: #171717;
}

QComboBox#revenuePeriod:hover {
    background: #E6E1D6;
}

QComboBox#revenuePeriod::drop-down {
    border: none;
    width: 22px;
}

QComboBox#revenuePeriod QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #EDE6D9;
    selection-color: #171717;
    outline: none;
}


QLabel#rowName {
    background: transparent;
}

QLabel#sectionLabel {
    background: transparent;
    letter-spacing: 0.2px;
}

/* VEHICLE CARDS (New Rental)
   A vehicle card paints its own panel and shadow so the hover lift can move
   them, so the frame and its shell stay unpainted. The blanket `QWidget` cream
   at the top of this file would otherwise fill them. The button's radius is
   VEHICLE_BTN_RADIUS; the test asserts the two agree. */
QFrame#vehicleCard, #vehicleSlot, #vehicleCardSurface, #vehicleCardSkeleton,
#brandRails, #brandSection, #vehicleRail, #vehicleRailViewport,
#vehicleRailHost {
    background: transparent;
    border: none;
}

QPushButton#vehicleDetailsButton {
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
    border-radius: 8px;
    color: #1A1A1A;
    font-size: 12px;
    font-weight: 700;
    padding: 0 14px;
}

QPushButton#vehicleDetailsButton:hover {
    background: #EEEAE1;
    border-color: #EEEAE1;
}

/* BRAND ROWS (New Rental)
   The fleet is grouped by make: a heading over a side-scrolling rail. The rail
   hides its vertical bar and shows a thin horizontal one, so a long brand is
   scrolled sideways rather than wrapped. */
QLabel#brandHeading {
    color: #1A1A1A;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
}

QScrollArea#vehicleRail QScrollBar:horizontal {
    height: 6px;
    background: transparent;
    margin: 0;
}

QScrollArea#vehicleRail QScrollBar::handle:horizontal {
    background: #D8CCBB;
    border-radius: 3px;
    min-width: 40px;
}

QScrollArea#vehicleRail QScrollBar::handle:horizontal:hover {
    background: #B8A68A;
}

QScrollArea#vehicleRail QScrollBar::add-line:horizontal,
QScrollArea#vehicleRail QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}

QScrollArea#vehicleRail QScrollBar::add-page:horizontal,
QScrollArea#vehicleRail QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* THE FILTER POPOVER (New Rental)
   White, 28px radius, 1px border: `class="card"`, the dashboard card's recipe, so
   the panel reads as a card lifted off the page rather than a native dropdown.
   No tint anywhere inside it either -- the 1px rule between the two columns and
   the ActiveRow ink bar are the only separators, because a filled second panel
   would make a 520px box look like two unrelated boxes. */
QFrame#filterPopover {
    background: #FFFFFF;
}

QFrame#filterPopoverDivider {
    background: #E4DCD0;
    border: none;
}

/* The Filters button in the pinned bar. A quiet pill, not a primary action: it is
   a way in to the filters, and the count beside it is the thing being read. */
QPushButton#filterButton {
    background: #EEEAE1;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #1A1A1A;
    padding: 0 14px;
}
QPushButton#filterButton:hover {
    background: #F3EEE4;
    border-color: #B8A68A;
}

QWidget#pagePinned QLineEdit#searchField {
    border-top-left-radius: 20px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    padding-left: 16px;
    padding-right: 16px;
}

QWidget#pagePinned QPushButton#filterButton {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

QWidget#pagePinned QPushButton#filterClear {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 0px;
}

/* The group headings use the same small-caps treatment as the dashboard's column
   labels, so the popover reads as part of the staff app rather than a foreign
   widget. */
QLabel#filterGroupHeading {
    color: #8A8175;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    background: transparent;
}

QWidget#filterPane, QWidget#filterPaneHost, QWidget#filterCategoryHost,
QWidget#filterGroup, QWidget#filterPaneScroll, QWidget#filterCategoryScroll,
QWidget#filterPanes, QWidget#pagePinned {
    background: transparent;
    border: none;
}

QLabel#filterCount {
    color: #8A8175;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QPushButton#filterClear {
    background: #FFFFFF;
    border: 1px solid #D8CCBB;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #1A1A1A;
    padding: 0 12px;
}
QPushButton#filterClear:hover:enabled {
    background: #F3EEE4;
    border-color: #B8A68A;
}
QPushButton#filterClear:disabled {
    color: #B5ADA1;
    border-color: #E4DCD0;
}

/* A disabled group is dimmed rather than hidden: the CC buckets stay visible and
   ticked when Motorcycle is unticked, so the clerk can see why they no longer
   apply and get them back by re-ticking. */
QCheckBox#filterCheck:disabled, QLabel#filterGroupHeading:disabled {
    color: #B5ADA1;
}

/* FLEET SIDE (New Rental)
   The search, the Filters button, the count and Clear all sit in the pinned row
   above the scroll area, so they stay reachable from any scroll position -- they
   used to scroll away with the first flick. The empty note is the one thing that
   still belongs inside the scroll area. */
QWidget#brandRails, QLabel#nrEmpty {
    background: transparent;
    border: none;
}

QLabel#nrCount {
    color: #8A8175;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#nrEmpty {
    color: #8A8175;
    font-size: 15px;
    background: transparent;
}

